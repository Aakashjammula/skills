{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*playwright.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_SKILLS_DIR/hooks/track-tokens.js\""
          }
        ]
      },
      {
        "matcher": ".*browser_navigate.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_SKILLS_DIR/hooks/log-navigation.js\""
          }
        ]
      }
    ]
  }
}
